{
	"name": "fediboost/fediboost",
	"description": "Automatically boost WordPress posts on connected Mastodon accounts when published via ActivityPub.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"yoast/phpunit-polyfills": "^2.0",
		"automattic/wordbless": "dev-allow-wp-7.0"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/Automattic/wordbless.git"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"test": "phpunit",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"clean": "rm -rf dist fediboost.zip",
		"build": [
			"@clean",
			"mkdir -p dist/fediboost",
			"rsync -av --exclude-from=.distignore ./ dist/fediboost/"
		],
		"zip": [
			"@build",
			"cd dist && zip -r ../fediboost.zip fediboost",
			"@post-zip"
		],
		"post-zip": "echo '\\n✅ Created fediboost.zip (ready for WordPress upload)'",
		"post-install-cmd": "WorDBless\\Composer\\InstallDropin::copy",
		"post-update-cmd": "WorDBless\\Composer\\InstallDropin::copy"
	},
	"config": {
		"platform": {
			"php": "7.4.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		}
	}
}
